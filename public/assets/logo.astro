<script>
	import { gsap } from 'gsap';

	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	// Only run animations if the user has not requested reduced motion
	if (!prefersReducedMotion.matches) {
		const fireDetails = gsap.utils.toArray('#fire-details-group path');
		const logo = document.getElementById('main-logo');

		if (fireDetails.length > 0) {
			const animation = gsap.to(fireDetails, {
				y: '-=35', // Move up by 35 units in SVG space
				duration: 7, // A slow, 7-second animation
				ease: 'sine.inOut', // A smooth, gentle ease
				stagger: {
					each: 0.5, // Stagger each animation by 0.5s
					from: 'random', // Start from random elements for a more natural feel
					yoyo: true, // Reverse the animation
					repeat: -1, // Repeat indefinitely
				},
				yoyo: true, // Reverse the main animation
				repeat: -1, // Repeat indefinitely
			});

			if (logo) {
				logo.addEventListener('mouseenter', () => {
					gsap.to(animation, { timeScale: 5, duration: 0.5, ease: 'power1.in' });
				});

				logo.addEventListener('mouseleave', () => {
					gsap.to(animation, { timeScale: 1, duration: 1, ease: 'power1.out' });
				});
			}
		}
	}
</script>
