---
import '../styles/main.scss';

export interface Props {
	title: string;
	description: string;
}
const { title } = Astro.props;
const { description } = Astro.props;
---

<!doctype html>
<html lang='en'>
	<head>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width' />
		<meta name='generator' content={Astro.generator} />
		<meta name='description' content={description} />
		<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
	<script>
		import gsap from 'gsap';
		import { ScrollTrigger } from 'gsap/ScrollTrigger';

		gsap.registerPlugin(ScrollTrigger);

		document.addEventListener('DOMContentLoaded', () => {
			// --- 1. Hero Entrance Animation ---
			const hero = document.querySelector('.hero');
			if (hero) {
				const heroTl = gsap.timeline({
					defaults: { duration: 1.5, ease: 'power3.out', opacity: 0, y: 40 },
				});

				// Select elements that actually exist in your index.astro
				const title = hero.querySelector('h1');
				const subtitle = hero.querySelector('p');
				const nav = document.querySelector('nav'); // Nav is outside the hero

				heroTl.from(title, {}).from(subtitle, { y: 20 }, '-=1.2').from(nav, { y: -20 }, '-=1.3');
			}

			// --- 2. Staggered Animation for All Content Sections on Scroll ---
			const animatedSections = gsap.utils.toArray('section');

			animatedSections.forEach((section) => {
				// Select all direct children or specific elements you want to animate
				// We use a safe check to ensure we aren't animating empty sections
				if (section.children.length === 0) return;

				gsap.from(section.children, {
					y: 30, // Reduced distance for subtlety
					opacity: 0,
					duration: 1.2, // Slower duration for elegance
					ease: 'power3.out',
					stagger: 0.15, // Stagger the children
					scrollTrigger: {
						trigger: section,
						start: 'top 80%',
						once: true,
					},
				});
			});

			// --- 3. Subtle Parallax for Featured Images ---
			const parallaxImages = gsap.utils.toArray('.featured-card__image img');
			parallaxImages.forEach((img) => {
				gsap.to(img, {
					yPercent: 15, // Move image slightly within its container
					ease: 'none',
					scrollTrigger: {
						trigger: img,
						start: 'top bottom',
						end: 'bottom top',
						scrub: true,
					},
				});
			});

			// --- 4. Architectural Line Drawing for Separators ---
			const lines = gsap.utils.toArray('hr');
			lines.forEach((line) => {
				gsap.from(line, {
					scaleX: 0,
					opacity: 0,
					transformOrigin: 'left center',
					duration: 1.5,
					ease: 'expo.out',
					scrollTrigger: {
						trigger: line,
						start: 'top 90%',
						once: true,
					},
				});
			});
		});
	</script>
</html>
