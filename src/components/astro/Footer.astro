---
const currentYear = new Date().getFullYear();

const sitemap = [
	{ label: 'Work', href: '/work' },
	{ label: 'Studio', href: '/studio' },
	{ label: 'Services', href: '/services' },
	{ label: 'Contact', href: '/contact' },
];

const socials = [
	{ label: 'Twitter / X', href: '#' },
	{ label: 'Instagram', href: '#' },
	{ label: 'LinkedIn', href: '#' },
];
---

<footer class='footer'>
	<div class='container'>
		<div class='footer__top'>
			<div class='brand'>
				<span class='brand__jp jp-text'>エターニティー</span>
				<a href='/' class='brand__en header-text'>STUDIO EIEN</a>
			</div>
			<div class='cta'>
				<p>Ready to start?</p>
				<a href='/contact' class='cta__link header-text'>Start a Project</a>
			</div>
		</div>

		<hr class='footer__divider' />

		<div class='footer__bottom'>
			<div class='links-wrapper'>
				<div class='links-col'>
					<span class='col-title'>Sitemap</span>
					<ul>
						{
							sitemap.map((link) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))
						}
					</ul>
				</div>
				<div class='links-col'>
					<span class='col-title'>Socials</span>
					<ul>
						{
							socials.map((social) => (
								<li>
									<a href={social.href} target='_blank' rel='noopener noreferrer'>
										{social.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>

			<div class='meta'>
				<div class='meta__info regular-text'>
					<p>&copy; {currentYear} Studio Eien.</p>
					<p>All rights reserved.</p>
				</div>
				<div class='meta__decoration'>
					<span class='jp-text'>永遠</span>
				</div>
			</div>
		</div>
	</div>
</footer>

<style lang='scss'>
	.footer {
		background-color: #fffdf9;
		color: #1a1a1a;
		padding-block: 4rem 2rem;
		margin-top: auto;
		border-top: 1px solid rgba(0, 0, 0, 0.05);

		.container {
			max-width: 100rem;
			margin-inline: auto;
			padding-inline: 1rem;
		}

		&__top {
			display: flex;
			justify-content: space-between;
			align-items: flex-end;
			margin-bottom: 3rem;
			flex-wrap: wrap;
			gap: 2rem;

			.brand {
				display: flex;
				flex-direction: column;

				&__jp {
					font-size: 0.8rem;
					color: #666;
					display: flex;
					justify-content: flex-end;
				}

				&__en {
					font-size: 2rem;
					font-weight: 700;
					text-decoration: none;
					color: inherit;
					letter-spacing: -0.03em;
				}
			}

			.cta {
				text-align: right;

				p {
					font-size: 1rem;
					color: #666;
					margin-bottom: 0.5rem;
				}

				&__link {
					font-size: 1.5rem;
					font-weight: 600;
					color: inherit;
					text-decoration: none;
					padding-bottom: 2px;
					transition: opacity 0.3s ease;

					&:hover {
						opacity: 0.6;
					}
				}
			}
		}

		&__divider {
			border: none;
			height: 1px;
			background-color: rgba(0, 0, 0, 0.1);
			margin-bottom: 3rem;
		}

		&__bottom {
			display: flex;
			justify-content: space-between;
			flex-wrap: wrap;
			gap: 3rem;

			.links-wrapper {
				display: flex;
				gap: 4rem;
			}

			.links-col {
				display: flex;
				flex-direction: column;
				gap: 1rem;

				.col-title {
					font-size: 0.75rem;
					text-transform: uppercase;
					color: #888;
					letter-spacing: 0.05em;
				}

				ul {
					list-style: none;
					padding: 0;
					margin: 0;
					display: flex;
					flex-direction: column;
					gap: 0.5rem;

					a {
						text-decoration: none;
						font-size: 1.2rem;
						font-weight: 500;
						color: black;
						font-weight: bold;
						text-transform: uppercase;
						font-size: 1rem;
						display: inline-block;
						position: relative;
						transition: color 0.3s ease;

						&::after {
							content: '';
							position: absolute;
							bottom: -2px;
							left: 0;
							width: 0;
							height: 1px;
							background-color: currentColor;
							transition: width 0.3s ease;
						}

						&:hover {
							color: #555;
							&::after {
								width: 100%;
							}
						}
					}
				}
			}

			.meta {
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				align-items: flex-end;
				text-align: right;

				&__info {
					color: #666;
					line-height: 1.5;

					p {
						font-size: 1.2rem;
						text-transform: capitalize;
					}
				}

				&__decoration {
					margin-top: 1rem;
					font-size: 1.5rem;
					opacity: 0.2;
					font-family: serif;
				}
			}
		}

		@media (max-width: 768px) {
			&__top {
				flex-direction: column;
				align-items: flex-start;

				.cta {
					text-align: left;
				}
			}

			&__bottom {
				flex-direction: column;

				.links-wrapper {
					flex-direction: column;
					gap: 2rem;
				}

				.meta {
					align-items: flex-start;
					text-align: left;
					margin-top: 2rem;
				}
			}
		}
	}
</style>
