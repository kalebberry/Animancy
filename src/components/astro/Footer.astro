---
const currentYear = new Date().getFullYear();

const sitemap = [
	{ label: "Work", href: "/work" },
	{ label: "Studio", href: "/studio" },
	{ label: "Services", href: "/services" },
	{ label: "Contact", href: "/contact" },
];

const socials = [
	{ label: "Twitter / X", href: "#" },
	{ label: "Instagram", href: "#" },
	{ label: "LinkedIn", href: "#" },
];
---

<footer class="footer">
	<div class="container">
		<div class="footer__top">
			<div class="brand">
				<span class="brand__jp jp-text">エターニティー</span>
				<a href="/" class="brand__en header-text">STUDIO EIEN</a>
			</div>
			<div class="cta">
				<p>Ready to start?</p>
				<a href="/contact" class="cta__link header-text"
					>Start a Project</a
				>
			</div>
		</div>

		<hr class="footer__divider" />

		<div class="footer__bottom">
			<div class="links-wrapper">
				<div class="links-col">
					<span class="col-title">Sitemap</span>
					<ul>
						{
							sitemap.map((link) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))
						}
					</ul>
				</div>
				<div class="links-col">
					<span class="col-title">Socials</span>
					<ul>
						{
							socials.map((social) => (
								<li>
									<a
										href={social.href}
										target="_blank"
										rel="noopener noreferrer"
									>
										{social.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>

			<div class="meta">
				<div class="meta__info regular-text">
					<p>&copy; {currentYear} Studio Eien.</p>
					<p>All rights reserved.</p>
				</div>
				<div class="meta__decoration">
					<span class="jp-text">永遠</span>
				</div>
			</div>
		</div>
	</div>
</footer>

<style>
	.footer {
		background-color: #fffdf9;
		color: var(--text);
		padding-block: 4rem 2rem;
		margin-top: auto;
		border-top: 1px solid rgba(0, 0, 0, 0.05);
	}

	.footer .container {
		max-width: 100rem;
		margin-inline: auto;
		padding-inline: 1rem;
	}

	.footer__top {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		margin-bottom: 3rem;
		flex-wrap: wrap;
		gap: 2rem;
	}

	.footer__top .brand {
		display: flex;
		flex-direction: column;
	}

	.footer__top .brand__jp {
		font-size: 0.8rem;
		color: #666;
		display: flex;
		justify-content: flex-end;
	}

	.footer__top .brand__en {
		font-size: 2rem;
		font-weight: 700;
		text-decoration: none;
		color: inherit;
		letter-spacing: -0.03em;
	}

	.footer__top .cta {
		text-align: right;
	}

	.footer__top .cta p {
		font-size: 1rem;
		color: #666;
		margin-bottom: 0.5rem;
	}

	.footer__top .cta__link {
		font-size: 1.5rem;
		font-weight: 600;
		color: inherit;
		text-decoration: none;
		padding-bottom: 2px;
		transition: opacity 0.3s ease;
	}

	.footer__top .cta__link:hover {
		opacity: 0.6;
	}

	.footer__divider {
		border: none;
		height: 1px;
		background-color: rgba(0, 0, 0, 0.1);
		margin-bottom: 3rem;
	}

	.footer__bottom {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 3rem;
	}

	.footer__bottom .links-wrapper {
		display: flex;
		gap: 4rem;
	}

	.footer__bottom .links-col {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.footer__bottom .col-title {
		font-size: 0.75rem;
		text-transform: uppercase;
		color: #888;
		letter-spacing: 0.05em;
	}

	.footer__bottom .links-col ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.footer__bottom .links-col ul a {
		text-decoration: none;
		font-weight: bold;
		text-transform: uppercase;
		font-size: 1rem;
		color: black;
		display: inline-block;
		position: relative;
		transition: color 0.3s ease;
	}

	.footer__bottom .links-col ul a::after {
		content: "";
		position: absolute;
		bottom: -2px;
		left: 0;
		width: 0;
		height: 1px;
		background-color: currentColor;
		transition: width 0.3s ease;
	}

	.footer__bottom .links-col ul a:hover {
		color: #555;
	}

	.footer__bottom .links-col ul a:hover::after {
		width: 100%;
	}

	.footer__bottom .meta {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		align-items: flex-end;
		text-align: right;
	}

	.footer__bottom .meta__info {
		color: #666;
		line-height: 1.5;
	}

	.footer__bottom .meta__info p {
		font-size: 1.2rem;
		text-transform: capitalize;
	}

	.footer__bottom .meta__decoration {
		margin-top: 1rem;
		font-size: 1.5rem;
		opacity: 0.2;
		font-family: serif;
	}

	@media (max-width: 768px) {
		.footer__top {
			flex-direction: column;
			align-items: flex-start;
		}

		.footer__top .cta {
			text-align: left;
		}

		.footer__bottom {
			flex-direction: column;
		}

		.footer__bottom .links-wrapper {
			flex-direction: column;
			gap: 2rem;
		}

		.footer__bottom .meta {
			align-items: flex-start;
			text-align: left;
			margin-top: 2rem;
		}
	}
</style>
