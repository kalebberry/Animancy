---
import Logo from './logo.astro';

const links = [
	{ label: 'Work', href: '/work' },
	{ label: 'Studio', href: '/studio' },
	{ label: 'Reach Out', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<nav class='nav' aria-label='Primary'>
	<div class='brand'>
		<a href='/' aria-label='Home'>
			<div class='brand__logo'>
				<Logo />
			</div>
		</a>
	</div>

	<button class='mobile-toggle' aria-expanded='false' aria-label='Toggle navigation'>
		<span class='bar'></span>
		<span class='bar'></span>
		<span class='bar'></span>
	</button>

	<!-- Desktop links -->
	<ul class='links' aria-label='Primary links'>
		{
			links.map((l) => (
				<li>
					<a
						class={`link ${
							currentPath === l.href || (l.href !== '/' && currentPath.startsWith(l.href))
								? 'active'
								: ''
						}`}
						href={l.href}>
						{l.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<script>
	const navToggle = document.querySelector('.mobile-toggle');
	const navLinks = document.querySelector('.links');

	// Mobile Menu Logic
	if (navToggle && navLinks) {
		navToggle.addEventListener('click', () => {
			const isExpanded = navToggle.getAttribute('aria-expanded') === 'true';
			navToggle.setAttribute('aria-expanded', (!isExpanded).toString());
			navToggle.classList.toggle('is-active');
			navLinks.classList.toggle('is-open');
		});
	}
</script>

<style>
	.nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-inline: clamp(3em, 5vw, 4em);
		padding-block: 0.5rem;
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(250, 248, 245, 0.6);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(0, 0, 0, 0.05);
		.brand {
			display: flex;
			align-items: center;
			gap: 1rem;

			.brand__logo {
				width: 50px;
				height: auto;

				:global(svg) {
					width: 100%;
					height: auto;
					display: block;
				}
			}
		}

		.mobile-toggle {
			display: none;
			flex-direction: column;
			gap: 4px;
			background: none;
			border: none;
			cursor: pointer;
			padding: 0.5rem;

			.bar {
				width: 24px;
				height: 2px;
				background-color: var(--text);
				transition: all 0.3s ease;
			}

			&.is-active {
				.bar:nth-child(1) {
					transform: translateY(6px) rotate(45deg);
				}
				.bar:nth-child(2) {
					opacity: 0;
				}
				.bar:nth-child(3) {
					transform: translateY(-6px) rotate(-45deg);
				}
			}
		}

		.links {
			display: flex;
			gap: 2rem;
			list-style: none;

			.link {
				text-decoration: none;
				font-size: 1.3rem !important;
				font-weight: 500;
				color: var(--text);
				font-weight: bold;
				text-transform: uppercase;
				font-size: 1rem;
				display: inline-block;
				position: relative;
				transition: color 0.3s ease;

				&::after {
					content: '';
					position: absolute;
					bottom: -2px;
					left: 0;
					width: 0;
					height: 1px;
					background-color: currentColor;
					transition: width 0.3s ease;
				}

				&:hover,
				&.active {
					color: #555;
					&::after {
						width: 100%;
					}
				}
			}
		}

		@media (max-width: 768px) {
			.mobile-toggle {
				display: flex;
			}

			.links {
				position: absolute;
				top: 100%;
				left: 0;
				right: 0;
				flex-direction: column;
				background: rgb(250, 249, 246, 0.9);
				padding: 2rem;
				gap: 1.5rem;
				text-align: center;
				display: none;
				border-bottom: 1px solid rgba(0, 0, 0, 0.1);

				&.is-open {
					display: flex;
				}
			}
		}
	}
</style>
