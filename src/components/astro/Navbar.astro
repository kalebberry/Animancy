---
const links = [
	{ label: 'Work', href: '/work' },
	{ label: 'Studio', href: '/studio' },
	{ label: 'Reach Out', href: '/contact' },
];

const logo = '/assets/img/cute_profofile.png';
---

<nav class='nav' aria-label='Primary'>
	<div class='brand'>
		<a href='/' aria-label='Home'>
			<img class='brand__img' src={logo} alt='' />
			<!-- <span class='brand__name'>Studio Eien</span> -->
		</a>
	</div>

	<button class='mobile-toggle' aria-expanded='false' aria-label='Toggle navigation'>
		<span class='bar'></span>
		<span class='bar'></span>
		<span class='bar'></span>
	</button>

	<!-- Desktop links -->
	<ul class='links' aria-label='Primary links'>
		{
			links.map((l) => (
				<li>
					<a class='link' href={l.href}>
						{l.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<script>
	const navToggle = document.querySelector('.mobile-toggle');
	const navLinks = document.querySelector('.links');

	if (navToggle && navLinks) {
		navToggle.addEventListener('click', () => {
			const isExpanded = navToggle.getAttribute('aria-expanded') === 'true';
			navToggle.setAttribute('aria-expanded', (!isExpanded).toString());
			navToggle.classList.toggle('is-active');
			navLinks.classList.toggle('is-open');
		});
	}
</script>

<style lang='scss'>
	.nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-inline: 1rem;
		position: relative;
		.brand {
			display: flex;
			align-items: center;
			gap: 1rem;

			.brand__img {
				width: 50px;
				height: 50px;
			}
		}

		.mobile-toggle {
			display: none;
			flex-direction: column;
			gap: 4px;
			background: none;
			border: none;
			cursor: pointer;
			padding: 0.5rem;

			.bar {
				width: 24px;
				height: 2px;
				background-color: black;
				transition: all 0.3s ease;
			}

			&.is-active {
				.bar:nth-child(1) {
					transform: translateY(6px) rotate(45deg);
				}
				.bar:nth-child(2) {
					opacity: 0;
				}
				.bar:nth-child(3) {
					transform: translateY(-6px) rotate(-45deg);
				}
			}
		}

		.links {
			display: flex;
			gap: 2rem;
			list-style: none;

			.link {
				text-decoration: none;
				font-size: 1.2rem;
				font-weight: 500;
				color: black;
				font-weight: bold;
				text-transform: uppercase;
				font-size: 1rem;
			}
		}

		@media (max-width: 768px) {
			.mobile-toggle {
				display: flex;
			}

			.links {
				position: absolute;
				top: 100%;
				left: 0;
				right: 0;
				flex-direction: column;
				background: white;
				padding: 2rem;
				gap: 1.5rem;
				text-align: center;
				display: none;
				border-bottom: 1px solid rgba(0, 0, 0, 0.1);

				&.is-open {
					display: flex;
				}
			}
		}
	}
</style>
