---
type WorkItem = {
	label: string;
	client: string;
	service: string;
	description: string;
	image: string;
	link: string;
};

const projects: WorkItem[] = [
	{
		label: '01',
		client: 'Exilium',
		service: 'Digital Experiences',
		description: 'A tactical RPG interface design focusing on clarity and atmosphere.',
		image:
			'https://ik.imagekit.io/sorudev/Studio%20Eien/Backgrounds/magazine_cover_manga_5__kFkAQWP5U.png?updatedAt=1708435704056',
		link: '/work/exilium',
	},
	{
		label: '02',
		client: 'Kitsune',
		service: 'Interface Systems',
		description: 'Modern aesthetics meeting traditional folklore in this character showcase.',
		image:
			'https://ik.imagekit.io/sorudev/Studio%20Eien/Backgrounds/magazine_cover_manga_aIgWKOCZh.png?updatedAt=1708435702457',
		link: '/work/kitsune',
	},
	{
		label: '03',
		client: 'Craft',
		service: 'Interactive Motion',
		description: 'Minimalist portfolio template designed for digital craftsmen.',
		image:
			'https://ik.imagekit.io/sorudev/Studio%20Eien/Backgrounds/magazine_cover_manga_6_pl5KrIjUA.png?updatedAt=1708435691450',
		link: '/work/craft',
	},
	{
		label: '04',
		client: 'Bunny',
		service: 'Performance',
		description: 'Playful mascot design and branding for a local cafe.',
		image:
			'https://ik.imagekit.io/sorudev/Studio%20Eien/Backgrounds/manga_beautiful_7qMh10Vza.png?updatedAt=1708505549765',
		link: '/work/bunny',
	},
	{
		label: '05',
		client: 'Ronin',
		service: 'Content Architecture',
		description: 'Forging a strong, silent visual identity for a security firm.',
		image:
			'https://ik.imagekit.io/sorudev/Studio%20Eien/Backgrounds/magazine_cover_manga_5__kFkAQWP5U.png?updatedAt=1708435704056',
		link: '/work/ronin',
	},
	{
		label: '06',
		client: 'Sakura',
		service: 'CMS Integration',
		description: 'Delicate, eco-friendly packaging design for organic teas.',
		image:
			'https://ik.imagekit.io/sorudev/Studio%20Eien/Backgrounds/magazine_cover_manga_aIgWKOCZh.png?updatedAt=1708435702457',
		link: '/work/sakura',
	},
];

// Get unique categories for the filter
const categories = ['All', ...new Set(projects.map((p) => p.service))];
---

<div class='gallery-wrapper'>
	<div class='filter-bar'>
		{
			categories.map((cat, i) => (
				<button
					class={`filter-btn ${i === 0 ? 'active' : ''}`}
					data-filter={cat}
					aria-label={`Filter by ${cat}`}>
					{cat}
				</button>
			))
		}
	</div>

	<div class='work-grid'>
		{
			projects.map((p) => (
				<article class='work-card' data-category={p.service}>
					<a href={p.link} class='work-card__link'>
						<div class='work-card__bg' style={`background-image: url(${p.image})`} />
						<div class='work-card__overlay' />
						<div class='work-card__content'>
							<div class='work-card__top'>
								<span class='work-card__label'>{p.label}</span>
								<span class='work-card__service'>{p.service}</span>
							</div>
							<div class='work-card__main'>
								<h3 class='work-card__client'>{p.client}</h3>
								<p class='work-card__desc'>{p.description}</p>
							</div>
							<div class='work-card__action'>
								<span class='btn-cta'>View Case Study</span>
							</div>
						</div>
					</a>
				</article>
			))
		}
	</div>
</div>

<script>
	const filterButtons = document.querySelectorAll('.filter-btn');

	// Filter Logic
	filterButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			// Update active button state
			filterButtons.forEach((b) => b.classList.remove('active'));
			btn.classList.add('active');

			const filterValue = btn.getAttribute('data-filter');
			const cards = document.querySelectorAll('.work-card');

			cards.forEach((card) => {
				const category = card.getAttribute('data-category');
				if (filterValue === 'All' || category === filterValue) {
					card.classList.remove('hidden');
				} else {
					card.classList.add('hidden');
				}
			});
		});
	});
</script>

<style lang='scss'>
	@use 'sass:map';
	@use '../../styles/abstracts/' as *;

	.gallery-wrapper {
		display: flex;
		flex-direction: column;
		gap: map.get($space, 24);
	}

	.filter-bar {
		display: flex;
		flex-wrap: wrap;
		gap: map.get($space, 16);
		padding-bottom: map.get($space, 16);
	}

	.filter-btn {
		background: transparent;
		border: 1px solid rgba(255, 255, 255, 0.2);
		color: $font-color-default;
		padding: 8px 16px;
		border-radius: 100px;
		cursor: pointer;
		font-family: 'Familjen Grotesk', sans-serif;
		font-size: 0.875rem;
		transition: all 0.3s ease;

		&:hover {
			border-color: rgba(255, 255, 255, 0.5);
			color: $font-color-default;
		}

		&.active {
			background: #fff;
			border-color: #fff;
			color: #000;
		}
	}

	.work-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: map.get($space, 24);
	}

	.work-card {
		position: relative;
		aspect-ratio: 3/4;
		border-radius: 12px;
		overflow: hidden;
		background: #111;
		border: 1px solid rgba(255, 255, 255, 0.1);
		transition:
			transform 0.3s ease,
			box-shadow 0.3s ease;

		&.hidden {
			display: none;
		}

		&:hover {
			transform: translateY(-4px);
			box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);

			.work-card__bg {
				transform: scale(1.05);
				opacity: 0.6;
			}

			.btn-cta {
				background: #fff;
				color: #000;
			}
		}
	}

	.work-card__link {
		display: block;
		height: 100%;
		text-decoration: none;
		color: inherit;
	}

	.work-card__bg {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		opacity: 0.4;
		transition:
			transform 0.6s ease,
			opacity 0.3s ease;
	}

	.work-card__overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to top,
			rgba(0, 0, 0, 0.9) 0%,
			rgba(0, 0, 0, 0.2) 60%,
			transparent 100%
		);
	}

	.work-card__content {
		position: absolute;
		inset: 0;
		padding: map.get($space, 24);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		z-index: 2;
	}

	.work-card__top {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
	}

	.work-card__label {
		font-family: 'Familjen Grotesk', sans-serif;
		font-weight: bold;
		font-size: 1.25rem;
		color: rgba(255, 255, 255, 0.9);
	}

	.work-card__service {
		font-size: 0.875rem;
		color: rgba(255, 255, 255, 0.6);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.work-card__main {
		margin-top: auto;
		margin-bottom: map.get($space, 16);
	}

	.work-card__client {
		font-family: 'Familjen Grotesk', sans-serif;
		font-size: 2rem;
		font-weight: bold;
		color: #fff;
		margin-bottom: 0.5rem;
	}

	.work-card__desc {
		font-size: 0.9375rem;
		color: rgba(255, 255, 255, 0.8);
		line-height: 1.5;
	}

	.btn-cta {
		display: inline-block;
		padding: 0.5rem 1rem;
		border: 1px solid rgba(255, 255, 255, 0.3);
		border-radius: 100px;
		font-size: 0.875rem;
		color: #fff;
		transition: all 0.3s ease;
	}
</style>
