---
export interface Props {
  content: string;
  description: string;
}
const { content } = Astro.props;
---

<div>
  <a href="#" class="btn btn-primary" role="button" aria-label="button">{content}</a>
</div>

<style lang="scss">
  @use "sass:map";
  @use "../../styles/abstracts/" as *;

  .btn {
    display: block;
    max-width: fit-content;
    border: 1px solid black;
    padding: 0.8rem 1rem;
    border-radius: 5px;
    text-decoration: none;
    color: $font-color-default;
    font-size: var(--);
  }
</style>
