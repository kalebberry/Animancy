---
export interface Props {
	content: string;
	href?: string;
	theme?: 'primary' | 'light';
}
const { content, href = '#', theme = 'primary' } = Astro.props;
---

<div>
	<a href={href} class={`btn btn-${theme}`} role='button' aria-label='button'>{content}</a>
</div>

<style lang='scss'>
	@use 'sass:map';
	@use '../../styles/abstracts/' as *;

	.btn {
		display: block;
		max-width: fit-content;
		padding: 0.8rem 1rem;
		border-radius: 5px;
		text-decoration: none;
		font-size: var(--);
	}

	.btn-primary {
		border: 1px solid black;
		color: $font-color-default;
	}

	.btn-light {
		border: 1px solid white;
		color: white;
	}
</style>
