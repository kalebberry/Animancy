---
export interface Props {
	content: string;
	href?: string;
	theme?: 'primary' | 'light';
}
const { content, href = '#', theme = 'primary' } = Astro.props;
---

<div class='btn-wrapper'>
	<a href={href} class={`btn btn-${theme}`} role='button' aria-label='button'>
		{content}
		<svg xmlns='http://www.w3.org/2000/svg' width='1em' height='1em' viewBox='0 0 24 24'>
			<!-- Icon from Material Line Icons by Vjacheslav Trushkin - https://github.com/cyberalien/line-md/blob/master/license.txt -->
			<g
				fill='none'
				stroke='currentColor'
				stroke-linecap='round'
				stroke-linejoin='round'
				stroke-width='2'
			>
				<path
					class='path-box'
					stroke-dasharray='64'
					stroke-dashoffset='64'
					d='M4 12v7c0 0.55 0.45 1 1 1h14c0.55 0 1 -0.44 1 -1v-14c0 -0.55 -0.45 -1 -1 -1h-14c-0.55 0 -1 0.45 -1 1Z'
				>
				</path>
				<path
					class='path-arrow'
					stroke-dasharray='6'
					stroke-dashoffset='6'
					d='M14 12l-3 -3M14 12l-3 3'
				>
				</path>
			</g>
		</svg>
	</a>
</div>

<style>
	@keyframes draw {
		to {
			stroke-dashoffset: 0;
		}
	}

	.btn-wrapper {
		margin-top: 2rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		max-width: fit-content;
		padding: 0.8rem 1rem;
		border-radius: 5px;
		text-decoration: none;
		font-size: var(--fs-step-0);

		svg {
			width: 0;
			opacity: 0;
			margin-left: 0;
			overflow: visible;
			transition: all 0.3s ease;
			transform: translateY(1px);
		}

		&:hover svg {
			width: 1em;
			opacity: 1;
			margin-left: 0.5rem;
		}

		&:hover .path-box {
			animation: draw 0.6s forwards;
		}

		&:hover .path-arrow {
			animation: draw 0.3s 0.6s forwards;
		}
	}

	.btn-primary {
		border: 1px solid var(--text);
		color: var(--text);
		background: transparent;
		transition: all 0.3s ease;

		&:hover {
			background: var(--text);
			color: var(--background);
		}
	}

	.btn-light {
		border: 1px solid white;
		color: white;
	}
</style>
