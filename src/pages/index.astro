---
import Layout from '../Layouts/DefaultLayout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title='Studio Eien' description='Welcome to Studio Eien'>
	<main>
		<nav class='navbar'>
			<ul role='list' class='navbar__links'>
				<li><a href='/'>Logo</a></li>
				<li><a href='/about'>Case Studies</a></li>
				<li><a href='/portfolio'>Studio</a></li>
				<li><a href='/contact'>Reach out</a></li>
			</ul>
		</nav>
		<section class='hero'>
			<header>
				<div class='hero__title'>
					<span>エターニティー</span>
					<h1>STUDIO EIEN</h1>
				</div>
				<p>
					We craft timeless digital ⟡ experiences for businesses, content creators, and artists.
					Studio Eien helps you take the first steps toward building an online presence that
					embodies your vision. The presence that tells the world what you stand for.
				</p>
			</header>
			<div>
				<hr />
				<p>Grid System V.03</p>
				<p>VERSION: 03.2025 ⟡ PLATFORM: DIGITAL EXPERIENCE</p>
			</div>
		</section>

		<section class='process'>
			<header>
				<div class='process__title'>
					<span>プロセス</span>
					<h2>PROCESS</h2>
				</div>
			</header>

			<div>
				<article>
					<h3>01. Strategy</h3>
					<p>Understanding shapes direction.</p>
					<p>
						We start by diving deep into goals, values, and audience. Through open conversation, we
						gather the insights that shape a thoughtful, informed strategy before any pixels are
						drawn.
					</p>
				</article>

				<article>
					<h3>02. Design</h3>
					<p>Purpose guides beauty.</p>
					<p>
						We translate your content and story into visual concepts that speak your brand’s
						language. Every layout, color, and interaction is intentional; designed to align beauty
						with usability.
					</p>
				</article>

				<article>
					<h3>03. Code</h3>
					<p>Precision becomes experience.</p>
					<p>
						We build using modern frameworks and clean and scalable code. Ensuring, your website is
						fast, accessible, and ready. Every feature and detail is crafted with precision.
					</p>
				</article>
			</div>
			<div>
				<hr />
				<p>SECTION: PROCESS ⟡ METHOD SIGNATURE: V.01</p>
			</div>
		</section>

		<section class='quote'>
			<div>
				<h4>永遠 Eternity</h4>
				<p>
					(Noun) — which may take the genitive case particle no, Na-adjective (keiyōdōshi).
					Eternity; perpetuity; permanence; immortality.
				</p>
			</div>
		</section>

		<section class='services'>
			<header>
				<div class='services__title'>
					<span>サービス</span>
					<h2>SERVICES</h2>
				</div>
			</header>
			<article>
				<div class='services__wd'>
					<header>
						<h3>WEB DESIGN</h3>
					</header>
					<p>
						We use the right tools for the right job — blending design and engineering to create
						online experiences that empower your next move. Let’s build something that reflects your
						passion and ambition.
					</p>
				</div>
				<div class='services__bg'>
					<header>
						<h3>BROADCAST GRAHICS</h3>
					</header>
					<p>
						Using NodeCG, we design and implement custom broadcast graphics and stream overlays —
						from seamless transitions to subtle alert animations — enhancing your live presence with
						professional polish.
					</p>
				</div>
				<div class='services__uxui'>
					<header>
						<h3>UX / UI</h3>
					</header>
					<p>
						We design intuitive interfaces grounded in research and accessibility. From wireframes
						to prototypes, our process ensures a frictionless experience that feels both human and
						memorable.
					</p>
				</div>
				<div class='services__uxui'>
					<header>
						<h3>Fluid Development</h3>
					</header>
					<p>
						From single-page apps to complex digital systems, we specialize in building tailored web
						solutions that evolve with your goals — complete with SEO, scalability, and soul.
					</p>
				</div>
			</article>
			<div>
				<hr />
				<p>SECTION: SERVICES ⟡ METHOD SIGNATURE: V.02</p>
			</div>
		</section>

		<section class='conversion'>
			<header>
				<div class='conversion__title'>
					<span>サービス</span>
					<h2>START YOUR STORY</h2>
				</div>
				<p>
					Step into our creative process — where ideas become impact. Explore client case studies
					and see how Studio Eien transforms visions into soulful, strategic web design.
				</p>
			</header>
		</section>
		<div>
			<hr />
			<p>SECTION:YOUR STORY ⟡ METHOD SIGNATURE: V.03</p>
		</div>
	</main>
</Layout>
