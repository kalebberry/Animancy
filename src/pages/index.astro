---
import Layout from '../Layouts/DefaultLayout.astro';
import Navbar from '../components/astro/Navbar.astro';
import Footer from '../components/astro/Footer.astro';
import Button from '@/components/astro/button.astro';
import ExpandingCard from '../components/astro/expandingCard.astro';
---

<Layout title='Studio Eien' description='Welcome to Studio Eien'>
	<main>
		<Navbar />
		<section class='hero hero-content'>
			<div class='container' data-type='wide'>
				<header>
					<div class='hero__title'>
						<span class='text-accent'>エターニティー</span>
						<h1>STUDIO EIEN</h1>
					</div>
					<p>
						We craft timeless digital experiences for businesses, content creators, and artists.
						Studio Eien helps you take the first steps toward building an online presence that
						embodies your vision. The presence that tells the world what you stand for.
					</p>
				</header>
			</div>
		</section>

		<div class='decoration'>
			<div class='container' data-type='full-bleed'>
				<hr />
				<div class='decoration__text'>
					<p>Grid System V.03</p>
					<p>VERSION: 03.2025 ⟡ PLATFORM: DIGITAL EXPERIENCE</p>
				</div>
			</div>
		</div>

		<section class='featured cq-card flow'>
			<div class='container' data-type='wide'>
				<header class='featured__title'>
					<span class='text-accent'>注目プロジェクト</span>
					<h4>Featured Projects</h4>
				</header>
			</div>
			<ExpandingCard />
		</section>

		<section class='process'>
			<div class='container' data-type='wide'>
				<header>
					<div class='process__title'>
						<span>プロセス</span>
						<h2>PROCESS</h2>
					</div>
				</header>

				<div class='process__content'>
					<article class='process__content__card'>
						<h3>01. Strategy</h3>
						<p>Understanding shapes direction.</p>
						<p>
							We start by diving deep into goals, values, and audience. Through open conversation,
							we gather the insights that shape a thoughtful, informed strategy before any pixels
							are drawn.
						</p>
					</article>

					<article class='process__content__card'>
						<h3>02. Design</h3>
						<p>Purpose guides beauty.</p>
						<p>
							We translate your content and story into visual concepts that speak your brand’s
							language. Every layout, color, and interaction is intentional; designed to align
							beauty with usability.
						</p>
					</article>

					<article class='process__content__card'>
						<h3>03. Code</h3>
						<p>Precision becomes experience.</p>
						<p>
							We build using modern frameworks and clean and scalable code. Ensuring, your website
							is fast, accessible, and ready. Every feature and detail is crafted with precision.
						</p>
					</article>

					<!-- To Equalize Card Space -->
					<article class='process__content__card'></article>
				</div>
			</div>
		</section>

		<div class='decoration' data-type='full-bleed'>
			<div class='container' data-type='full-bleed'>
				<hr />
				<div class='decoration__text__end'>
					<p>SECTION: PROCESS ⟡ METHOD SIGNATURE: V.01</p>
				</div>
			</div>
		</div>

		<section class='quote'>
			<div class='container' data-type='full-bleed'>
				<div class='quote__content'>
					<h4><span class='jp-text'>永遠</span> Eternity</h4>
					<p>
						(Noun) — which may take the genitive case particle no, Na-adjective (keiyōdōshi).
						Eternity; perpetuity; permanence; immortality.
					</p>
				</div>
			</div>
		</section>

		<section class='services'>
			<div class='container' data-type='wide'>
				<header>
					<div class='services__title'>
						<span>サービス</span>
						<h2>SERVICES</h2>
					</div>
				</header>
				<article class='services__content'>
					<div class='services__content__card flow'>
						<h3>01. Web Design</h3>
						<p>
							We use the right tools for the right job, blending design and engineering to create
							online experiences that empower your next move. Let’s build something that reflects
							your passion and ambition.
						</p>
					</div>
					<div class='services__content__card flow'>
						<h3>02. Broadcast Graphics</h3>

						<p>
							Using NodeCG, we design and implement custom broadcast graphics and stream overlays.
							From seamless transitions to subtle alert animations, enhancing your live presence
							with professional polish.
						</p>
					</div>
					<div class='services__content__card flow'>
						<h3>03. UX / UI</h3>

						<p>
							We design intuitive interfaces grounded in research and accessibility. From wireframes
							to prototypes, our process ensures a frictionless experience that feels both human and
							memorable.
						</p>
					</div>
					<div class='services__content__card flow'>
						<h3>04. Fluid Development</h3>

						<p>
							From single-page apps to complex digital systems, we specialize in building tailored
							web solutions that evolve with your goals, complete with SEO, scalability, and soul.
						</p>
					</div>
				</article>
			</div>
		</section>
		<div class='decoration'>
			<div class='container' data-type='full-bleed'>
				<hr />
				<div class='decoration__text__start'>
					<p>SECTION: SERVICES ⟡ METHOD SIGNATURE: V.02</p>
				</div>
			</div>
		</div>

		<section class='conversion container' data-type='wide'>
			<header class='flow'>
				<div class='conversion__title'>
					<span>サービス</span>
					<h2>START YOUR STORY</h2>
				</div>
				<p>
					Step into our creative process, where ideas become impact. Explore client case studies and
					see how Studio Eien transforms visions into soulful, strategic web design.
				</p>
				<Button content='Lets Work Together' />
			</header>
		</section>
		<div class='decoration'>
			<div class='container' data-type='full-bleed'>
				<hr />
				<div class='decoration__text__end'>
					<p>SECTION:YOUR STORY ⟡ METHOD SIGNATURE: V.03</p>
				</div>
			</div>
		</div>

		<Footer />
	</main>
</Layout>
