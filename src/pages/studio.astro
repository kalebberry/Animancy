---
import Layout from '../layouts/DefaultLayout.astro';
import Navbar from '../components/astro/Navbar.astro';
import Footer from '../components/astro/Footer.astro';
---

<Layout title='Studio Eien' description='Studio'>
  <main>
    <Navbar />
    <section class='hero hero-content'>
      <div class='container' data-type='wide'>
        <header>
          <div class='hero__title'>
            <span class='text-accent'>スタジオ</span>
            <h1>Our Studio</h1>
          </div>

          <p>
            Studio Eien is a frontend-focused design practice dedicated to building thoughtful digital experiences. We
            work with businesses, creators, and artists to transform ideas into structured, scalable websites that feel
            intentional and refined.
          </p>
        </header>
      </div>
    </section>

    <section class='philosophy flow-large'>
      <div class='container flow-large' data-type='wide'>
        <header>
          <div class='philosophy__title'>
            <span class='text-accent'>理念</span>
            <h2>Our Philosophy</h2>
          </div>
        </header>

        <div class='grid gap-8' data-cols='2'>
          <article class='philosophy__card flow-large'>
            <h4>Clarity First</h4>
            <p>
              Every layout decision should reduce ambiguity, not add to it. If a user has to think about the interface,
              we've failed.
            </p>
          </article>
          <article class='philosophy__card flow-large'>
            <h4>Structured Flexibility</h4>
            <p>
              We build systems that scale with content, not around it — grids and components that adapt instead of
              breaking.
            </p>
          </article>
          <article class='philosophy__card flow-large'>
            <h4>Intentional Craft</h4>
            <p>
              Nothing ships by accident. Spacing, motion, and hierarchy are chosen deliberately, then refined until they
              feel inevitable.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section></section>
  </main>

  <Footer />
</Layout>
