---
import Layout from '../layouts/DefaultLayout.astro';
import Navbar from '../components/astro/Navbar.astro';
import Footer from '../components/astro/Footer.astro';
---

<Layout title='Studio Eien' description='Studio'>
  <main>
    <Navbar />
    <section class='hero hero-content'>
      <div class='container' data-type='wide'>
        <header>
          <div class='hero__title'>
            <span class='text-accent'>スタジオ</span>
            <h1>Our Studio</h1>
          </div>

          <p>
            Studio Eien is a frontend-focused design practice dedicated to building thoughtful digital experiences. We
            work with businesses, creators, and artists to transform ideas into structured, scalable websites that feel
            intentional and refined.
          </p>
        </header>
      </div>
    </section>

    <div class='decoration' data-type='full-bleed'>
      <div class='container' data-type='full-bleed'>
        <hr />
        <div class='decoration__text__end'>
          <p>SECTION: STUDIO ⟡ METHOD SIGNATURE: V.01</p>
        </div>
      </div>
    </div>

    <section class='studio-story'>
      <div class='container flow-large' data-type='wide'>
        <header>
          <div class='studio-story__title'>
            <span class='text-accent'>フィロソフィー</span>
            <h2>The Story</h2>
          </div>
        </header>
        <div class='flow-large'>
          <p>Eien means "eternity"</p>

          <p>
            The name reflects a simple idea: good digital work should not exist only to follow what is popular today.
          </p>
          <p>
            Studio Eien creates experiences with intention, balancing personality, usablity, performance, and technology
            to build something that can evolve without losing what made it distinct in the first place.
          </p>
        </div>
      </div>
    </section>

    <div class='decoration' data-type='full-bleed'>
      <div class='container' data-type='full-bleed'>
        <hr />
        <div class='decoration__text__end'>
          <p>SECTION: STORY ⟡ METHOD SIGNATURE: V.02</p>
        </div>
      </div>
    </div>

    <section class='philosophy flow-large'>
      <div class='container flow-large' data-type='wide'>
        <header>
          <div class='philosophy__title'>
            <span class='text-accent'>フィロソフィー</span>
            <h2>Philosophy</h2>
          </div>
        </header>

        <div class='flow-large'>
          <article class='flow-large'>
            <h4>Clarity</h4>
            <p>
              Understand the problem before designing the solution. Every Project begins by stripping away noise and
              finding what acutally matters.
            </p>
          </article>
          <article class='flow-large'>
            <h4>Expression</h4>
            <p>
              A website should feel like the person or organization behind it. Design systems provide consistency
              without sacrificing character.
            </p>
          </article>
          <article class='philosophy__card flow-large'>
            <h4>Execution</h4>
            <p>
              Good ideas deserve careful implementation. Responsive behavior, accessibity, performance, and
              maintainable, code aren't finishing touches, they are part of the design.
            </p>
          </article>
        </div>
      </div>
    </section>

    <div class='decoration' data-type='full-bleed'>
      <div class='container' data-type='full-bleed'>
        <hr />
        <div class='decoration__text__end'>
          <p>SECTION: PHILOSOPHY ⟡ METHOD SIGNATURE: V.03</p>
        </div>
      </div>
    </div>

    <section class='philosophy flow-large'></section>
  </main>

  <Footer />
</Layout>
