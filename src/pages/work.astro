---
import Layout from '../Layouts/DefaultLayout.astro';
import Navbar from '../components/astro/Navbar.astro';
import Footer from '../components/astro/Footer.astro';
import Button from '@/components/astro/button.astro';
import WorkGallery from '../components/astro/WorkGallery.astro';
import LinkArrow from '@/components/astro/linkArrowIcon.astro';
---

<Layout title='Studio Eien' description='Work'>
  <main class='eien-pattern'>
    <Navbar />
    <section class='hero hero-content'>
      <div class='container' data-type='wide'>
        <header>
          <div class='hero__title'>
            <span class='text-accent'>仕事と作品</span>
            <h1>WORK</h1>
          </div>
          <p>
            A selection of digital experiences shaped by strategy, restraint, and purpose. We design and build systems
            that balance clarity and expression. Each project guided by the needs of its audience and the values of its
            creator.
          </p>
        </header>
      </div>
    </section>

    <div class='decoration' data-type='full-bleed'>
      <div class='container' data-type='full-bleed'>
        <hr />
        <div class='decoration__text__end'>
          <p>SECTION: PROCESS ⟡ METHOD SIGNATURE: V.01</p>
        </div>
      </div>
    </div>

    <section class='work-statement work-content'>
      <div class='container flow-large' style='--space:4rem;' data-type='wide'>
        <header>
          <div class='work__title'>
            <span class='text-accent'>プロジェクト一覧</span>
            <h2>PROJECT INDEX</h2>
          </div>
        </header>
        <WorkGallery />
      </div>
    </section>

    <section class='work-featured flow-large' style='--space:5rem;'>
      <div class='container flow-large' data-type='wide' style='--space:4rem;'>
        <header>
          <div class='work-featured__title'>
            <span class='text-accent'>プロジェクト一覧</span>
            <h2>FEATURED STUDY</h2>
          </div>
          <div>01 — 06</div>
        </header>
        <div class='flow-large' '>
          <h3>EXILIUM</h3>
          <p>
            A tactical RPG interface exploring how information, hierarchy, and atmosphere can coexist without
            overwhelming the player.
          </p>
        </div>
      </div>

      <div class='container flow-large' data-type='full-bleed'>
        <img src='/src/assets/img/test.jfif' />
        <div class='work-featured__tags'>
          <div><p>INTERFACE DESIGN</p></div>
          <div><p>UI SYSTEMS</p></div>
          <div><p>2026</p></div>
        </div>
        <div class='work-featured__link'>
          <a href='#'><span>EXPLORE CASE STUDY</span> <LinkArrow /></a>
        </div>
      </div>
    </section>

    <div class='decoration'>
      <div class='container' data-type='full-bleed'>
        <hr />
        <div class='decoration__text__end'>
          <p>SECTION:YOUR STORY ⟡ METHOD SIGNATURE: V.03</p>
        </div>
      </div>
    </div>

    <section class='conversion container' data-type='wide'>
      <header class='flow'>
        <div class='conversion__title'>
          <span>サービス</span>
          <h2>START YOUR STORY</h2>
        </div>
        <p>
          Step into our creative process, where ideas become impact. Explore client case studies and see how Studio Eien
          transforms visions into soulful, strategic web design.
        </p>
        <Button content='Lets Work Together' />
      </header>
    </section>
    <div class='decoration'>
      <div class='container' data-type='full-bleed'>
        <hr />
        <div class='decoration__text__end'>
          <p>SECTION:YOUR STORY ⟡ METHOD SIGNATURE: V.03</p>
        </div>
      </div>
    </div>

    <Footer />
  </main>

  <style lang='scss'></style>
</Layout>
